# Normalize line endings in the repository: keep LF everywhere except for
# Windows-native formats. Prettier (.prettierrc "endOfLine": "lf") and
# .editorconfig require LF, so committing CRLF would make `format:check` fail
# on Windows checkouts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf